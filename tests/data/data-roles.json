    "wu-result"
   ],
   "why": "block-scalar text holding * and & is text, not an alias or anchor"
  },
  {
   "src": "artifact: wu-plan\ntitle: \"&x *y\"\nnote: '*z'\n",
   "roles": [
    "wu-plan"
   ],
   "why": "quoted text starting with & or * is text"
  },
  {
   "src": "artifact: [epic-result,\n  wu-result]\n",
   "roles": [
    "epic-result",
    "wu-result"
   ],
   "why": "a flow list wrapped over two lines"
  },
  {
   "src": "artifact: wu-plan\nx: [[1, 2], [3]]\n",
   "roles": [
    "wu-plan"
   ],
   "why": "a nested flow list in another field"
  },
  {
   "src": "\"artifact\": wu-plan\n",
   "roles": [
    "wu-plan"
   ],
   "why": "a quoted key"
  },
  {
