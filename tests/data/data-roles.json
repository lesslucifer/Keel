  {
   "src": "  artifact: wu-result\n  id: E-A.W1\n",
   "roles": [
    "wu-result"
   ],
   "why": "a mapping indented as a whole"
  },
  {
   "src": "artifact: [wu-result, ]\n",
   "roles": [
    "wu-result"
   ],
   "why": "a trailing comma in a flow list"
